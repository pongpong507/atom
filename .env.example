# ================================================================
# Atom 環境變數設定檔
# 使用方式：複製此檔案為 .env 並填入正確值
#   cp .env.example .env
# ================================================================

# PostgreSQL 連線（Ubuntu 機的 Tailscale IP）
DATABASE_URL=postgresql://atom_user:your_password@100.x.x.x:5432/atom_db

# Ollama（Windows Docker 容器連接本機 Ollama）
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Obsidian Vault（容器內掛載路徑，不需修改）
VAULT_PATH=/app/vault

# Web 伺服器綁定地址
BIND_ADDR=0.0.0.0:8080

# Session Cookie 簽名金鑰（至少 64 字元，可用 openssl rand -hex 32 生成）
COOKIE_SECRET=change_this_to_64_random_chars_use_openssl_rand_hex_32_please

# 日誌等級（可選：trace / debug / info / warn / error）
RUST_LOG=atom=info,tower_http=info
